<% s = 'mailers.user_mailer.driver_trip_reminder' %>
<h1><%= t("#{s}.title") %></h1>

<p><%= t("#{s}.greeting", name: @user.name) %></p>
<p><%= t("#{s}.intro") %></p>

<%= render layout: 'card' do %>
  <p><strong><%= t("#{s}.route") %></strong> <%= @trip.departure_location %> → <%= @trip.arrival_location %></p>
  <p><strong><%= t("#{s}.departure") %></strong> <%= @departure_label %></p>
  <p><strong><%= t("#{s}.passengers") %></strong></p>
  <ul>
    <% @bookings.each do |b| %>
      <li><%= b.user.name %> · <%= b.seats %> × <%= b.pickup_location || @trip.departure_location %> → <%= b.dropoff_location || @trip.arrival_location %></li>
    <% end %>
  </ul>
<% end %>

<div style="text-align: center; margin: 32px 0;">
  <%= render 'button', url: @trip_url, text: t("#{s}.button") %>
</div>

<p><%= t("#{s}.tip_cancel") %></p>

<p><strong><%= t("#{s}.team") %></strong></p>
